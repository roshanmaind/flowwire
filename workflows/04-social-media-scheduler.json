        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $env.FACEBOOK_PAGE_ID }}/photos",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"url\": \"{{ $('Validate & Normalise Payload').first().json.image_url }}\",\n  \"message\": {{ JSON.stringify($('Validate & Normalise Payload').first().json.captions.facebook) }},\n  \"access_token\": \"{{ $credentials.accessToken }}\"\n}",
        "options": {}
      },
      "id": "node-fb-post",
      "name": "FB: Post Photo to Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [980, 400],
      "credentials": {
        "httpHeaderAuth": {
          "id": "FB_CREDENTIAL_ID",
          "name": "Facebook Graph API"
        }
      },
      "notes": "⚙ CONFIGURE: 'Facebook Graph API' credential — Header: Authorization, Value: Bearer <PAGE_ACCESS_TOKEN>"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.linkedin.com/v2/ugcPosts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"author\": \"urn:li:organization:{{ $env.LINKEDIN_ORGANIZATION_ID }}\",\n  \"lifecycleState\": \"PUBLISHED\",\n  \"specificContent\": {\n    \"com.linkedin.ugc.ShareContent\": {\n      \"shareCommentary\": {\n        \"text\": {{ JSON.stringify($('Validate & Normalise Payload').first().json.captions.linkedin) }}\n      },\n      \"shareMediaCategory\": \"IMAGE\",\n      \"media\": [\n        {\n          \"status\": \"READY\",\n          \"description\": { \"text\": \"\" },\n          \"originalUrl\": \"{{ $('Validate & Normalise Payload').first().json.image_url }}\"\n        }\n      ]\n    }\n  },\n  \"visibility\": {\n    \"com.linkedin.ugc.MemberNetworkVisibility\": \"PUBLIC\"\n  }\n}",
        "options": {}
      },
      "id": "node-li-post",
      "name": "LI: Create UGC Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [980, 620],
      "credentials": {
        "httpHeaderAuth": {
          "id": "LI_CREDENTIAL_ID",
          "name": "LinkedIn API"
        }
      },
      "notes": "⚙ CONFIGURE: 'LinkedIn API' credential — Header: Authorization, Value: Bearer <LINKEDIN_ACCESS_TOKEN>"
    },
    {
      "parameters": {
        "jsCode": "// Collect results from all three branches and build a summary.\nconst base = $('Validate & Normalise Payload').first().json;\n\nconst results = {\n  post_id:      base.post_id,\n  caption:      base.caption.slice(0, 80) + '...',\n  image_url:    base.image_url,\n  platforms:    base.platforms,\n  published_at: new Date().toISOString(),\n  ig_post_id:   null,\n  fb_post_id:   null,\n  li_post_id:   null,\n};\n\ntry { results.ig_post_id = $('IG: Publish Container').first().json.id || null; } catch(_) {}\ntry { results.fb_post_id = $('FB: Post Photo to Page').first().json.id || null; } catch(_) {}\ntry { results.li_post_id = $('LI: Create UGC Post').first().json.id   || null; } catch(_) {}\n\nreturn [{ json: results }];"
      },
      "id": "node-merge-results",
      "name": "Merge Publish Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1420, 400]
    },
