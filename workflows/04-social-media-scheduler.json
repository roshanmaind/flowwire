{
  "name": "04 · Social Media Scheduler — Webhook → Instagram · Facebook · LinkedIn",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "schedule-post",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "responseData": "firstEntryJson",
        "options": {}
      },
      "id": "node-webhook-scheduler",
      "name": "Schedule Post Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 400],
      "webhookId": "social-schedule-webhook",
      "notes": "⚙ CONFIGURE: Protect this webhook with Header Auth. In n8n, create an 'Header Auth' credential and set Authorization: Bearer <BACKEND_API_SECRET>. Your Node.js backend POSTs here with { caption, image_url, platforms: ['instagram','facebook','linkedin'] }"
    },
    {
      "parameters": {
        "jsCode": "// Validate and normalise the incoming post request.\nconst body = $input.first().json.body;\n\nconst caption      = body?.caption?.trim();\nconst image_url    = body?.image_url?.trim();\nconst platforms    = Array.isArray(body?.platforms) ? body.platforms : ['instagram', 'facebook', 'linkedin'];\nconst scheduled_at = body?.scheduled_at ? new Date(body.scheduled_at) : null;\n\nif (!caption) throw new Error('Validation: caption is required');\nif (!image_url) throw new Error('Validation: image_url is required');\n\n// Truncate caption per platform limit (Instagram: 2200, FB: 63206, LI: 3000)\nconst captions = {\n  instagram: caption.slice(0, 2200),\n  facebook:  caption.slice(0, 63206),\n  linkedin:  caption.slice(0, 3000),\n};\n\nreturn [{\n  json: {\n    caption,\n    image_url,\n    platforms,\n    captions,\n    scheduled_at: scheduled_at?.toISOString() || new Date().toISOString(),\n    post_id: `post_${Date.now()}`,\n  }\n}];"
      },
      "id": "node-validate",
      "name": "Validate & Normalise Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 400]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.platforms.join(',') }}",
              "operation": "contains",
              "value2": "instagram"
            }
          ]
        }
      },
      "id": "node-check-ig",
      "name": "Post to Instagram?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [680, 200]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.platforms.join(',') }}",
              "operation": "contains",
              "value2": "facebook"
            }
          ]
        }
      },
      "id": "node-check-fb",
      "name": "Post to Facebook?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [680, 400]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.platforms.join(',') }}",
              "operation": "contains",
              "value2": "linkedin"
            }
          ]
        }
      },
      "id": "node-check-li",
      "name": "Post to LinkedIn?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [680, 620]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $env.INSTAGRAM_BUSINESS_ACCOUNT_ID }}/media",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"image_url\": \"{{ $json.image_url }}\",\n  \"caption\": {{ JSON.stringify($json.captions.instagram) }},\n  \"access_token\": \"{{ $credentials.accessToken }}\"\n}",
        "options": {}
      },
      "id": "node-ig-container",
      "name": "IG: Create Media Container",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [980, 100],
      "credentials": {
        "httpHeaderAuth": {
          "id": "IG_CREDENTIAL_ID",
          "name": "Instagram Graph API"
        }
      },
      "notes": "⚙ CONFIGURE: 'Instagram Graph API' credential — Header: Authorization, Value: Bearer <INSTAGRAM_ACCESS_TOKEN>"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $env.INSTAGRAM_BUSINESS_ACCOUNT_ID }}/media_publish",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"creation_id\": \"{{ $json.id }}\",\n  \"access_token\": \"{{ $credentials.accessToken }}\"\n}",
        "options": {}
      },
      "id": "node-ig-publish",
      "name": "IG: Publish Container",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1200, 100],
      "credentials": {
        "httpHeaderAuth": {
          "id": "IG_CREDENTIAL_ID",
