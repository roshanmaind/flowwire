# ─── n8n Core ─────────────────────────────────────────────────────────────────
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Timezone used by cron triggers
GENERIC_TIMEZONE=Asia/Kolkata

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n_secret
POSTGRES_DB=n8n_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── WhatsApp Cloud API (Meta) ────────────────────────────────────────────────
# Generate at: https://developers.facebook.com/apps/<APP_ID>/whatsapp-business/
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
WHATSAPP_ACCESS_TOKEN=YOUR_WHATSAPP_PERMANENT_ACCESS_TOKEN
WHATSAPP_VERIFY_TOKEN=YOUR_WEBHOOK_VERIFY_TOKEN

# ─── Meta Ads ─────────────────────────────────────────────────────────────────
META_ADS_APP_ID=YOUR_META_APP_ID
META_ADS_APP_SECRET=YOUR_META_APP_SECRET
META_ADS_ACCESS_TOKEN=YOUR_META_LONG_LIVED_ACCESS_TOKEN

# ─── Cloudflare R2 ────────────────────────────────────────────────────────────
# Create R2 API tokens at: https://dash.cloudflare.com/ → R2 → Manage API tokens
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=expense-receipts
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ENDPOINT=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com

# ─── Exotel ───────────────────────────────────────────────────────────────────
# Get credentials at: https://my.exotel.com/
EXOTEL_API_KEY=YOUR_EXOTEL_API_KEY
EXOTEL_API_TOKEN=YOUR_EXOTEL_API_TOKEN
EXOTEL_SID=YOUR_EXOTEL_SID

# ─── Instagram Graph API ──────────────────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=YOUR_INSTAGRAM_LONG_LIVED_TOKEN
INSTAGRAM_BUSINESS_ACCOUNT_ID=YOUR_IG_BUSINESS_ACCOUNT_ID

# ─── Facebook Graph API ───────────────────────────────────────────────────────
FACEBOOK_PAGE_ACCESS_TOKEN=YOUR_FACEBOOK_PAGE_ACCESS_TOKEN
FACEBOOK_PAGE_ID=YOUR_FACEBOOK_PAGE_ID

# ─── LinkedIn API ─────────────────────────────────────────────────────────────
LINKEDIN_ACCESS_TOKEN=YOUR_LINKEDIN_ACCESS_TOKEN
LINKEDIN_ORGANIZATION_ID=YOUR_LINKEDIN_ORG_ID

# ─── Node.js Backend ──────────────────────────────────────────────────────────
BACKEND_API_URL=http://host.docker.internal:3000
BACKEND_API_SECRET=YOUR_SHARED_SECRET_FOR_INTERNAL_CALLS
